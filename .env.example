# Every variable the Image Annotator's scripts read (ADR-0010). No value here is a secret. The scripts
# read them from the environment (e.g. `HOST_ORIGINS=… pnpm build`), not from a file; if you keep a
# local .env to source in your shell, it is git-ignored. Only the local environment is filled in;
# production values are set in phase 7.

# Build time (MOD-Build): space-separated origins allowed to embed the tool. It sets the CSP
# frame-ancestors in public/_headers and the runtime message allow-list (RULE-16, NFR-09).
# Default when unset: https://tarokit.app. Empty value = standalone only. Wildcards are refused;
# http is accepted only for localhost / 127.0.0.1 (the local stub host).
# Local: the e2e host harness sets its own values (tests/e2e/support/urls.ts: http://localhost:4290),
# so you only need this to embed `pnpm preview` in your own local page, e.g.:
#   HOST_ORIGINS="https://tarokit.app http://localhost:4290"
HOST_ORIGINS="https://tarokit.app"

# Test time (optional): the port `pnpm test:e2e` previews dist/ on. Default 4173.
E2E_PORT=4173

# Release (phase 6, optional): where scripts/release-build clones and builds. Default $TMPDIR.
RELEASE_OUT=

# Phase 7 only — leave empty during development (nothing is provisioned before then, ADR-0010).
CLOUDFLARE_ACCOUNT_ID=
# Secret: never put a real value in a file. Set it in your shell when phase 7 needs it.
CLOUDFLARE_API_TOKEN=
