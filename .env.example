# Every variable the Image Annotator's scripts and tests read (ADR-0010; docs/deploy/environments.md).
# Names only: no value here is a secret, and no real secret ever goes in a file. The scripts read them
# from the environment (e.g. `HOST_ORIGINS=… pnpm build`), not from a file; if you keep a local .env to
# source in your shell, it is git-ignored. Only the local environment is filled in; production values are
# set by the owner in phase 7.

# ---- Build time (MOD-Build) -----------------------------------------------------------------------
# Space-separated origins allowed to embed the tool. It sets the CSP frame-ancestors in public/_headers
# and the runtime message allow-list (RULE-16, NFR-09). Default when unset: https://tarokit.app.
# Empty value = standalone only. Wildcards are refused; http is accepted only for localhost / 127.0.0.1
# (the local stub host). Local: the e2e host harness sets its own values (tests/e2e/support/urls.ts), so
# you only need this to embed `pnpm preview` in your own local page, e.g.:
#   HOST_ORIGINS="https://tarokit.app http://localhost:4290"
# Production release: HOST_ORIGINS="https://tarokit.app" (scripts/release-build exports this default).
HOST_ORIGINS="https://tarokit.app"

# ---- Release (phase 6, scripts/release-build) -------------------------------------------------------
# Output directory of the release build; must be outside the repository. Default $TMPDIR/ia-release-<ref>.
RELEASE_OUT=
# Set to 1 to skip the e2e suites in scripts/release-build (the reproducibility comparison uses it).
SKIP_E2E=
# Set by scripts/release-build for the e2e step; set it yourself to run Playwright as in CI
# (no reused servers, retries on, no `.only`).
CI=

# ---- Tests (local only) -----------------------------------------------------------------------------
# Port of the preview that `pnpm test:e2e` serves dist/ on. Default: 30000-31999, derived from the
# checkout path (tests/e2e/support/ports.ts), so parallel worktrees never collide.
E2E_PORT=
# First of the four host-harness ports (`pnpm test:e2e:host`). Default 20000-27996, per checkout.
E2E_HOST_PORT_BASE=
# Set to 1 to reuse an already running preview server instead of starting one.
E2E_REUSE=
# Set to 1 (QA only) to save a screenshot of every narrow state to .build-my-app/reports/screens/F-018/.
SCREENS=
# Set to 1 to write the portal-catalog screenshots into docs/deploy/screenshots/
# (tests/e2e/host/catalog-screenshots.spec.ts); otherwise they go to the test output folder.
CATALOG_SHOTS=
# Set by tests/e2e/qa/security-harness.config.ts for the QA security harness; not for manual use.
E2E_QA_HARNESS=
# Lighthouse (`pnpm lhci`): path of a Chrome/Chromium binary when none is installed.
CHROME_PATH=

# ---- Deploy (phase 7) - owner only. Leave empty during development; nothing is provisioned before then.
# Cloudflare account that receives the deploy (wrangler). Not secret; keep it out of git anyway.
CLOUDFLARE_ACCOUNT_ID=
# SECRET. Scoped Cloudflare API token for wrangler (alternative: interactive `wrangler login`).
# Never put a real value in a file: set it in your own shell when phase 7 needs it.
CLOUDFLARE_API_TOKEN=
