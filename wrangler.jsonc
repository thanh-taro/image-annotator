// Cloudflare static assets, assets only, no Worker script (ADR-0010, MOD-Build). Copied from DAFV.
// Used only by the owner by hand in phase 7 (ADR-0014); nothing is provisioned before then and
// nothing here is a secret. The account comes from the CLOUDFLARE_ACCOUNT_ID environment variable.
// Headers: dist/_headers (generated by `pnpm gen`, including the /sw.js exception).
// Not uploaded: dist/.assetsignore (from public/.assetsignore) lists *.map and .vite.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "image-annotator",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Unknown paths answer a plain 404 (a single-page tool with no client routes).
    "not_found_handling": "none",
  },
  // Only the custom domain serves the tool: no *.workers.dev address, no preview URLs (ADR-0010).
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "image-annotator.tarokit.app", "custom_domain": true }],
}
